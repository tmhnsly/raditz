{
  "name": "raditz",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "catalog"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/raditz.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:barrel": "node scripts/gen-barrel.mjs",
    "gen:catalog": "node scripts/gen-catalog.mjs",
    "validate:taxonomy": "node scripts/validate-taxonomy.mjs",
    "watch": "node scripts/watch.mjs",
    "build:lib": "vite build --config vite.lib.ts",
    "build:css": "vite build --config vite.css.ts",
    "build:pkg": "pnpm build:lib && pnpm build:css && node scripts/wrap-css-layer.mjs",
    "prepare": "pnpm build:pkg",
    "release:preflight": "node scripts/release-preflight.mjs",
    "codemod:use-client": "node scripts/add-use-client.mjs",
    "rdz:install-skills": "node scripts/install-global-skills.mjs"
  },
  "dependencies": {
    "@fontsource-variable/space-grotesk": "^5.2.10",
    "@fontsource/space-mono": "^5.2.9",
    "@radix-ui/colors": "^3.0.0",
    "@visx/axis": "^4.0.0",
    "@visx/curve": "^4.0.0",
    "@visx/gradient": "^4.0.0",
    "@visx/grid": "^4.0.0",
    "@visx/group": "^4.0.0",
    "@visx/responsive": "^4.0.0",
    "@visx/scale": "^4.0.0",
    "@visx/shape": "^4.0.0",
    "date-fns": "^4.4.0",
    "react-icons": "^5.6.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/react": "^8.6.18",
    "@storybook/react-vite": "^8.6.14",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "axe-core": "^4.12.1",
    "jsdom": "^29.1.1",
    "react": "^18.3.1",
    "react-docgen-typescript": "^2.4.0",
    "react-dom": "^18.3.1",
    "react-icons": "^5.6.0",
    "rollup-preserve-directives": "^1.1.3",
    "sass": "^1.101.0",
    "storybook": "^8.6.14",
    "typescript": "^5.6.3",
    "vite": "^6.0.5",
    "vite-plugin-dts": "^5.0.2",
    "vitest": "^2.1.9",
    "vitest-axe": "^0.1.0"
  },
  "packageManager": "pnpm@10.29.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
