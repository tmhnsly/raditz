{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "allowImportingTsExtensions": false
  },
  "include": ["src"],
  "exclude": [
    "src/pages/**",
    "src/explorer/**",
    "src/demos/**",
    "src/foundations/**",
    "src/App.tsx",
    "src/main.tsx",
    "src/a11y.test.tsx",
    "**/*.stories.tsx",
    "**/*.stories.ts",
    "**/*.test.tsx",
    "**/*.test.ts"
  ]
}
